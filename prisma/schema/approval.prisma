// approval.prisma
model Approval {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
requestId  String           @unique @db.ObjectId
  request    DeliveryRequest  @relation("RequestApprovals", fields: [requestId], references: [id])

  userApprovals UserApproval[] // Many-to-many relationship with User

  status     ApprovalStatus @default(PENDING)
  comments   String?
  level      Int
  approvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  
  isDeleted Boolean @default(false)

  @@map("approval")
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}