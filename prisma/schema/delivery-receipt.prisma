enum DeliveryReceiptStatus {
  pending
  partial
  completed
  rejected
}

enum Condition {
  good
  damaged
}

model DeliveryReceipt {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  receiptNumber String @unique

  deliveryRequestId String?          @db.ObjectId
  deliveryRequest   DeliveryRequest? @relation(fields: [deliveryRequestId], references: [id])

  deliveryOrderId String        @db.ObjectId
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])

  receivedDate DateTime @default(now())

  receivedById String @db.ObjectId
  receivedBy   User   @relation("ReceivedDeliveries", fields: [receivedById], references: [id])

  inspectedById String? @db.ObjectId
  inspectedBy   User?   @relation("InspectedBy", fields: [inspectedById], references: [id])

  condition           Condition?
  inspectionNotes     String?
  discrepancyReported Boolean    @default(false)
  discrepancyDetails  String?

  attachments String[] @default([])

  receiverSignature  String?
  delivererSignature String?
  items              ReceiptItem[]

  // Organization
  orgId        String?       @db.ObjectId
  organization Organization? @relation(fields: [orgId], references: [id])

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId

  @@index([deliveryRequestId])
  @@index([receivedDate])
  @@index([orgId])
  @@map("delivery_receipts")
}
