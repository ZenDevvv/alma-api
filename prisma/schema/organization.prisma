model Organization {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  code        String   @unique
  logo        String?
  background  String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  persons     Person[]

  // --- LMS Relations ---
  faculties     Faculty[]
  programs      Program[]
  categories    Category[]
  academicTerms AcademicTerm[]
  courses       Course[]
  sections      Section[]
  rubrics       Rubric[]

  @@index([name], name: "idx_organization_name")
}
