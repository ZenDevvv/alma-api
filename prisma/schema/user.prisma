enum UserStatus {
  active
  inactive
  suspended
  archived
}

model User {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  personId String?  @unique @db.ObjectId
  person   Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  avatar   String?
  userName String?  @unique
  email    String   @unique
  password String?
  role     Role
  subRole  SubRole?
  // auditLogs           AuditLogging[]
  // activityLogs        ActivityLogging[]

  userApprovals UserApproval[] // Many-to-many relationship with Approval

  transactions Transaction[] @relation("TransactionPerformedBy")

  requestedDeliveries DeliveryRequest[] @relation("RequestedDeliveries")
  approvedDeliveries  DeliveryRequest[] @relation("ApprovedDeliveries")
  rejectedDeliveries  DeliveryRequest[] @relation("RejectedDeliveries")

  receivedDeliveries DeliveryReceipt[] @relation("ReceivedDeliveries")

  preparedDeliveryOrder   DeliveryOrder[] @relation("PreparedDeliveries")
  dispatchedDeliveryOrder DeliveryOrder[] @relation("DispatchedDeliveries")

  deliveryInspections DeliveryReceipt[] @relation("InspectedBy")

  receivedStockItems StockItem[] @relation("StockItemReceivedBy")

  patients Patient[] @relation("Patients")

  status      UserStatus @default(active)
  isDeleted   Boolean    @default(false)
  lastLogin   DateTime?
  loginMethod String

  departmentId String?     @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])
  locationId   String?     @db.ObjectId
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  orgId        String?       @db.ObjectId
  organization Organization? @relation(fields: [orgId], references: [id])

  activityLogs    ActivityLog[]
  auditLogs       AuditLog[]
  DeliveryReceipt DeliveryReceipt[]

  @@map("users")
}

enum Role {
  user
  admin
  viewer
}

enum SubRole {
  super
  supervisor
  approver
  staff
  operator
  malasakit
  patient
}

