model Transaction {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  transactionNumber String
  referenceNumber   String          @unique // Ensures each reference (delivery receipt/order ID) is used only once across all transactions
  sequence          Int // Sequence number for the year
  year              Int // Year for the sequence      
  type              TransactionType
  performedById     String          @db.ObjectId
  performedAt       DateTime        @default(now())
  sourceId          String          @db.ObjectId //supplier or department
  sourceType        SourceType
  destinationId     String          @db.ObjectId
  isDeleted         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  performedBy User       @relation("TransactionPerformedBy", fields: [performedById], references: [id])
  destination Department @relation("TransactionDestination", fields: [destinationId], references: [id])

  transactionItems TransactionItem[]

  @@index([type])
  @@index([performedAt])
  @@index([performedById])
  @@index([year])
  @@index([sequence])
}

enum TransactionType {
  in
  out
  adjustment
}
