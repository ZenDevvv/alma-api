// user-approval.prisma
// Explicit join table for many-to-many relationship between User and Approval
model UserApproval {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  approvalId String   @db.ObjectId
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  
  // Additional fields for the relationship
  assignedAt DateTime @default(now())
  role       String?  // e.g., "primary_approver", "secondary_approver", etc.
  order      Int?     // Order of approval if sequential approval is needed
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([userId, approvalId]) // Prevent duplicate user-approval pairs
  @@map("user_approvals")
  @@index([userId])
  @@index([approvalId])
}
